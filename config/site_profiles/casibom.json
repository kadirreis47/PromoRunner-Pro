{
  "site_name": "CASIBOM",
  "timeout_ms": 15000,
  "variables": {
    "code": "${promo_code}",
    "platform": "PromoRunner"
  },
  "steps": [
    {
      "action": "goto",
      "url": "https://example.com"
    },
    {
      "action": "wait",
      "selector": "body"
    },
    {
      "action": "assert_url",
      "contains": "example.com"
    },
    {
      "action": "assert_text",
      "text": "Example Domain"
    },
    {
      "action": "extract_text",
      "selector": "h1",
      "label": "Sayfa başlığı",
      "save_as": "page_title"
    },
    {
      "action": "log",
      "message": "Koşul başarılı: ${page_title}",
      "if": {
        "operator": "contains",
        "left": "${page_title}",
        "right": "Example"
      }
    },
    {
      "action": "log",
      "message": "BU SATIR YAZILMAMALI",
      "if": {
        "operator": "equals",
        "left": "${site}",
        "right": "ROBIN"
      }
    },
    {
      "action": "log",
      "message": "${platform} | Site: ${site} | Kod: ${code}"
    },
    {
      "action": "screenshot",
      "path": "logs/screenshots/casibom_condition_test.png"
    }
  ]
}